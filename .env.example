# ============================================================
# Verigence Audit Core — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ============================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=dev                           # dev | development | staging | production
SERVICE_NAME=verigence-audit-core

# ── Logging ───────────────────────────────────────────────────────────────────
AUDIT_CORE_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
AUDIT_CORE_LOG_STDOUT=true            # false = suppress stdout JSON lines

# ── Observability — success events ────────────────────────────────────────────
# Emit structured log events for successful mutating operations (booking commands,
# workflow transitions). Set to false to suppress success-path logs in high-throughput
# environments or during load testing.
AUDIT_CORE_SUCCESS_EVENTS_ENABLED=true

# ── Observability — sub-transaction tracing ───────────────────────────────────
# Emit trace_span log lines (via StructuredLogTelemetrySink) for sub-operations
# such as booking.authorize and booking.db_lock. Defaults false; enable in staging
# or when investigating latency. Auto-switches to no-op once OTel OTLP is active.
AUDIT_CORE_TRACE_SPANS_ENABLED=false

# ── Observability — slow request threshold ────────────────────────────────────
# Requests whose total duration exceeds this value (milliseconds) emit a
# WARNING log event "http_request_slow" regardless of HTTP status. Default 2000ms.
AUDIT_CORE_SLOW_REQUEST_THRESHOLD_MS=2000

# ── Observability — OTel (Phase-1, opt-in) ────────────────────────────────────
# Keep false until OTLP endpoint and credentials are configured. Exporters use
# bounded background batching; Audit Core never depends on the telemetry backend
# to complete business requests.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2
OBSERVABILITY_BATCH_DELAY_MS=1000
OBSERVABILITY_MAX_QUEUE_SIZE=2048
OBSERVABILITY_MAX_EXPORT_BATCH_SIZE=512
OBSERVABILITY_METRIC_EXPORT_INTERVAL_MS=60000

# Standard OpenTelemetry OTLP/HTTP configuration. Do not commit real tokens.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<axiom-domain>/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://<axiom-domain>/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-logs
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<axiom-domain>/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Bearer <token>,x-axiom-metrics-dataset=verigence-metrics

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/DB?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Security integration ──────────────────────────────────────────────────────
SECURITY_BASE_URL=                    # https://<security-host>
SECURITY_JWKS_URL=                    # https://<security-host>/.well-known/jwks.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. If empty, defaults to the dev Worker
# origin in dev/development environments and blocks all others in production.
AUDIT_CORE_CORS_ALLOWED_ORIGINS=

# ── Legacy / deprecated (kept for Railway env-var compatibility) ──────────────
# These fields are parsed but have no effect. Axiom drain was removed in obs-phase-1.
# AUDIT_CORE_LOG_AXIOM=false
# AUDIT_CORE_AXIOM_TOKEN=
# AUDIT_CORE_AXIOM_DATASET=
