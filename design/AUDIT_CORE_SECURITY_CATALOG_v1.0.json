    {"key": "audit.finding.update", "name": "Acknowledge/update finding workflow metadata"},
    {"key": "audit.finding.resolve", "name": "Resolve/void finding under permitted policy"},

    {"key": "audit.review.read", "name": "Read review history"},
    {"key": "audit.review.decide", "name": "Record TL review decision (Breach/No Breach/Send Back)"},

    {"key": "audit.work.read", "name": "Read assigned/permitted work items"},
    {"key": "audit.work.update", "name": "Claim/start/complete permitted work items"},
    {"key": "audit.work.manage", "name": "Reassign/cancel/manage work items within scope"},

    {"key": "audit.daily_ops.read", "name": "Read daily/EOD operations"},
    {"key": "audit.daily_ops.execute", "name": "Execute PC daily/EOD operations"},
    {"key": "audit.daily_ops.review", "name": "Review team daily/EOD operations"},

    {"key": "audit.crm.read", "name": "Read CRM follow-up work/interactions"},
    {"key": "audit.crm.execute", "name": "Record CRM call attempts/outcomes"},
    {"key": "audit.crm.manage", "name": "Manage CRM follow-up queues/rules within scope"},

    {"key": "audit.escalation.read", "name": "Read business escalations"},
    {"key": "audit.escalation.manage", "name": "Open/assign/update/close business escalations"},

    {"key": "audit.analytics.read", "name": "Read Audit Core operational/business analytics"},
    {"key": "audit.audit_trail.read", "name": "Read authoritative Audit Core audit trail"}
