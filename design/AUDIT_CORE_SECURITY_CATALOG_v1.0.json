    {"key": "audit.delivery.verify", "name": "Complete delivery physical/business verification"},

    {"key": "audit.trade_in.read", "name": "Read trade-in audit data"},
    {"key": "audit.trade_in.write", "name": "Record/update trade-in audit data"},
    {"key": "audit.trade_in.verify", "name": "Complete trade-in verification"},

    {"key": "audit.finding.read", "name": "Read evaluations/findings"},
