FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["sh", "-c", "PYTHONPATH=src uvicorn audit_core.verigence_attendance.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
